# Allowlist: ignore everything at the root, then re-include project files.
/*
!/.gitignore
!/.prettierrc
!/.prettierignore
!/app.json
!/eslint.config.js
!/jest.setup.ts
!/package.json
!/package-lock.json
!/tsconfig.json
!/README.md
!/app/
!/assets/
!/docs/
!/scripts/
!/src/

# Never commit, even inside allowed folders.
.env
.env.*
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.apk
*.aab
*.hprof
btsnoop*
bugreport*
*.log
.DS_Store
